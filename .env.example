# App URL (used to build public share links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase: Project URL and anon/publishable key (safe for the browser; RLS protects data)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# Supabase: SERVER-ONLY service role / secret key. NEVER expose to the client or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Billing is a DEMO (no payment gateway). No Stripe variables are required.
